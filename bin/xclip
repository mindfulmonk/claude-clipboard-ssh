#!/usr/bin/env python3
"""
xclip stub for use with claude-wrap.

The wrapper has already done the OSC 5522 dance and dropped clipboard bytes
into $XDG_RUNTIME_DIR/xclip-shim-<uid>/. All we have to do here is parse
xclip's CLI and serve from that cache.

Supports:
  xclip -selection clipboard -t TARGETS -o      → list MIME types in cache
  xclip -selection clipboard -t <mime> -o       → dump cached bytes for mime
  xclip -selection clipboard -o                 → text fallback via OSC 52
  xclip -selection clipboard -i                 → text write via OSC 52

For clipboard writes (`-i`) we fall back to OSC 52 over /dev/tty since the
wrapper doesn't intercept that direction.
"""
import base64
import os
import select
import sys
import termios
import time
import tty

CACHE_DIR = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
    f"xclip-shim-{os.getuid()}",
)
CACHE_TTL = 60.0
LOG_PATH = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "xclip-shim.log",
)


def log(*args):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        with open(LOG_PATH, "a") as f:
            f.write(f"[{time.strftime('%H:%M:%S')} pid={os.getpid()}] "
                    + " ".join(str(a) for a in args) + "\n")
    except Exception:
        pass


def cache_fresh():
    try:
        return time.time() - os.path.getmtime(os.path.join(CACHE_DIR, ".ts")) < CACHE_TTL
    except OSError:
        return False


def cache_list_mimes():
    if not cache_fresh():
        return []
    out = []
    try:
        for name in os.listdir(CACHE_DIR):
            if name.startswith("."):
                continue
            try:
                if os.path.getsize(os.path.join(CACHE_DIR, name)) > 0:
                    out.append(name.replace("_", "/", 1))
            except OSError:
                pass
    except OSError:
        pass
    return out


def cache_read(mime):
    if not cache_fresh():
        return None
    path = os.path.join(CACHE_DIR, mime.replace("/", "_"))
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return None


def osc52_write(data, selection="clipboard"):
    """Write to clipboard via OSC 52 over /dev/tty."""
    try:
        fd = os.open("/dev/tty", os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        return
    sel = "c" if selection == "clipboard" else "p"
    b64 = base64.b64encode(data).decode("ascii")
    try:
        os.write(fd, f"\x1b]52;{sel};{b64}\x1b\\".encode())
    finally:
        os.close(fd)


def parse_args(argv):
    action = "in"
    selection = "primary"
    target = "UTF8_STRING"
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("-o", "-out"):
            action = "out"
        elif a in ("-i", "-in"):
            action = "in"
        elif a in ("-selection", "-sel"):
            i += 1
            if i < len(argv):
                selection = argv[i]
        elif a in ("-t", "-target"):
            i += 1
            if i < len(argv):
                target = argv[i]
        elif a in ("-d", "-display", "-l", "-loops"):
            i += 1
        elif a in ("-version", "-h", "-help"):
            print("xclip-stub (cache-server for claude-wrap)")
            sys.exit(0)
        i += 1
    return action, selection, target


def main():
    log("argv:", sys.argv)
    action, selection, target = parse_args(sys.argv)

    if action == "in":
        data = sys.stdin.buffer.read()
        log(f"clipboard write: {len(data)} bytes via OSC 52")
        osc52_write(data, selection)
        return

    if target == "TARGETS":
        mimes = cache_list_mimes()
        log(f"TARGETS: {mimes}")
        out = ["TARGETS", "TIMESTAMP", "MULTIPLE"]
        if "text/plain" in mimes:
            out += ["UTF8_STRING", "STRING", "TEXT", "text/plain"]
        for m in mimes:
            if m not in out:
                out.append(m)
        sys.stdout.write("\n".join(out) + "\n")
        return

    mime = target
    if target in ("UTF8_STRING", "STRING", "TEXT"):
        mime = "text/plain"

    data = cache_read(mime)
    if data is not None:
        log(f"served {mime}: {len(data)} bytes")
        sys.stdout.buffer.write(data)
        return

    log(f"no cache for {mime}")
    sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:
        log("fatal:", repr(e))
        sys.exit(1)
