#!/usr/bin/env python3
"""
tmux-wrap — run tmux through an OSC 5522 clipboard bridge so Claude Code can
paste images over SSH *inside tmux*.

Why a separate wrapper from claude-wrap:

  ghostty's OSC 5522 paste-event packets are unsolicited terminal output that
  the app reads as input. tmux's input parser does not understand OSC 5522 and
  drops it — there is no inbound equivalent of `allow-passthrough`. So a bridge
  running *inside* tmux (claude-wrap) never sees the paste. The only place
  above tmux's filter is the process that launched tmux.

  tmux-wrap is that process. It sits between ghostty and tmux:

      ghostty <─ tty ─> [tmux-wrap] <─ pty ─> tmux <─> panes <─> claude

  1. We send `CSI ? 5522 h` straight up to ghostty (tmux is below us, so no
     passthrough wrapping is needed).
  2. On paste, ghostty sends the OSC 5522 packets down to us — before tmux.
     We grab the password (ghostty) / note its absence (kitty), pick a MIME,
     fire `type=read`, and accumulate the data response.
  3. We stash the bytes in the xclip-shim cache (Linux) and/or push them onto
     the Mac's NSPasteboard (darwin) — the same cache the pane's claude reads.
  4. We inject Ctrl+V down into tmux, which forwards it to the focused pane.
     claude's normal xclip/osascript paste flow fires and the image attaches.

The same applies to herdr, which also drops OSC 5522 on input. Invoke this
script as `herdr-wrap` (symlink or copy) and it wraps herdr instead of tmux;
everything else is identical.

So: launch `tmux-wrap` instead of `tmux` (or `herdr-wrap` instead of
`herdr`). Inside, run `claude` (or `claude-wrap`, which harmlessly exec's
claude once it sees it can't bridge from inside the multiplexer). Paste with your normal shortcut.

Debug log: $XDG_STATE_HOME/tmux-wrap.log
"""
import base64
import errno
import fcntl
import os
import pty
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import time
import tty

LOG_PATH = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "tmux-wrap.log",
)
CACHE_DIR = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
    f"xclip-shim-{os.getuid()}",
)
PREFERRED_MIMES = [
    "image/png", "image/jpeg", "image/gif", "image/webp", "image/bmp",
    "text/plain", "text/uri-list", "text/html",
]
DATA_RESPONSE_TIMEOUT = 5.0   # seconds; ghostty's password expires at 5s


def log(*args):
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        with open(LOG_PATH, "a") as f:
            f.write(f"[{time.strftime('%H:%M:%S')} pid={os.getpid()}] "
                    + " ".join(str(a) for a in args) + "\n")
    except Exception:
        pass


def is_ghostty():
    if os.environ.get("GHOSTTY_RESOURCES_DIR"):
        return True
    if "ghostty" in os.environ.get("TERM_PROGRAM", "").lower():
        return True
    if "ghostty" in os.environ.get("TERM", "").lower():
        return True
    return False


def is_kitty():
    if os.environ.get("KITTY_WINDOW_ID") or os.environ.get("KITTY_PID"):
        return True
    if "kitty" in os.environ.get("TERM", "").lower():
        return True
    return False


def is_supported_terminal():
    return is_ghostty() or is_kitty()


# ---- OSC 5522 protocol helpers ----

OSC_START = b"\x1b]"
OSC_ST = b"\x1b\\"
BEL = b"\x07"


def find_complete_osc(buf, start=0):
    """Return (osc_payload_inclusive_indices, after_idx) for the first
    complete OSC sequence starting at or after `start`, else (None, len)
    if there is none. If a partial OSC is in progress, returns
    (None, partial_start) so caller knows where the unparsed bytes begin.
    """
    i = start
    while i < len(buf):
        if buf[i:i + 2] == OSC_START:
            j = i + 2
            while j < len(buf):
                if buf[j:j + 2] == OSC_ST:
                    return (i, j + 2), j + 2
                if buf[j:j + 1] == BEL:
                    return (i, j + 1), j + 1
                j += 1
            # incomplete OSC — wait for more bytes
            return None, i
        i += 1
    return None, len(buf)


def parse_osc_meta(metadata):
    out = {}
    for item in metadata.split(b":"):
        if b"=" in item:
            k, _, v = item.partition(b"=")
            out[k.strip()] = v.strip()
    return out


def parse_5522_packet(osc_bytes):
    """Returns (fields_dict, payload_bytes_or_None) or None.
    osc_bytes includes the framing (\\x1b]...ST/BEL)."""
    if not osc_bytes.startswith(b"\x1b]5522;"):
        return None
    body = osc_bytes[len(b"\x1b]"):]  # strip leading framing
    # strip trailing terminator
    if body.endswith(OSC_ST):
        body = body[:-2]
    elif body.endswith(BEL):
        body = body[:-1]
    # body starts with "5522;<meta>" or "5522;<meta>;<payload>"
    rest = body[len(b"5522;"):]
    meta, sep, payload = rest.partition(b";")
    fields = parse_osc_meta(meta)
    return fields, (payload if sep else None)


# ---- cache (matches xclip shim's layout) ----

def cache_write(by_mime):
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    # clear stale entries
    try:
        for f in os.listdir(CACHE_DIR):
            try:
                os.unlink(os.path.join(CACHE_DIR, f))
            except OSError:
                pass
    except OSError:
        pass
    for mime, data in by_mime.items():
        safe = mime.replace("/", "_")
        with open(os.path.join(CACHE_DIR, safe), "wb") as f:
            f.write(data)
    open(os.path.join(CACHE_DIR, ".ts"), "wb").close()


# ---- macOS clipboard write ----
# Claude Code on darwin reads images via osascript from the real NSPasteboard,
# not via xclip, so the xclip-shim cache is never consulted there. Push the
# bytes onto the Mac's pasteboard so claude's own osascript read finds them.
# Side effect: overwrites the remote Mac's clipboard (fine on an ssh target).

MACOS_CLIPBOARD_FLAVORS = {
    "image/png":  "«class PNGf»",
    "image/jpeg": "«class JPEG»",
    "image/tiff": "«class TIFF»",
}


def load_into_macos_clipboard(data, mime):
    flavor = MACOS_CLIPBOARD_FLAVORS.get(mime)
    if not flavor:
        log(f"macOS clipboard: no flavor mapping for {mime}, skipping")
        return False
    try:
        fd, path = tempfile.mkstemp(prefix="tmux-wrap-paste-", suffix=".bin")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
    except OSError as e:
        log(f"macOS clipboard: tmpfile err: {e}")
        return False
    try:
        script = f'set the clipboard to (read POSIX file "{path}" as {flavor})'
        r = subprocess.run(
            ["osascript", "-e", script],
            capture_output=True, timeout=3,
        )
        if r.returncode != 0:
            log(f"macOS clipboard: osascript rc={r.returncode} stderr={r.stderr!r}")
            return False
        log(f"macOS clipboard: loaded {len(data)} bytes ({mime})")
        return True
    except Exception as e:
        log(f"macOS clipboard: osascript err: {e}")
        return False
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass


# ---- main loop with state machine ----

STATE_IDLE = "IDLE"
STATE_COLLECTING_PASTE = "COLLECTING_PASTE"   # got password, accumulating MIME list
STATE_AWAITING_DATA = "AWAITING_DATA"          # sent read req, accumulating data


def proxy(master_fd):
    """Bidirectional proxy with OSC 5522 paste-event interception.

    stdin (0) carries ghostty -> us (-> tmux); we sniff it for OSC 5522.
    master_fd carries tmux -> us (-> ghostty); pure passthrough.
    """
    stdin_fd = 0
    stdout_fd = 1

    state = STATE_IDLE
    current_password = None
    current_mime_list = []
    request_deadline = 0
    data_buf = bytearray()   # for data response payload (b64 chunks)
    data_mime = None

    in_buf = bytearray()     # bytes from ghostty awaiting OSC parsing

    while True:
        # If we're awaiting data, set a deadline so a broken response
        # doesn't strand us forever.
        timeout = None
        if state == STATE_AWAITING_DATA:
            remaining = request_deadline - time.monotonic()
            if remaining <= 0:
                log("data response timeout — abandoning paste")
                state = STATE_IDLE
                current_password = None
                # tell the pane SOMETHING so it doesn't hang
                synthesize_paste(master_fd, b"")
                continue
            timeout = remaining

        try:
            r, _, _ = select.select([stdin_fd, master_fd], [], [], timeout)
        except OSError as e:
            if e.errno == errno.EINTR:
                continue
            raise

        # Output direction first: anything tmux says, ghostty hears.
        if master_fd in r:
            try:
                data = os.read(master_fd, 65536)
            except OSError:
                return
            if not data:
                return
            try:
                os.write(stdout_fd, data)
            except OSError:
                return

        # Input direction: bytes from ghostty. Filter for OSC 5522.
        if stdin_fd in r:
            try:
                data = os.read(stdin_fd, 65536)
            except OSError:
                return
            if not data:
                return
            in_buf.extend(data)

            # Process all complete OSCs we can
            cursor = 0
            forward_chunks = bytearray()
            while cursor < len(in_buf):
                # Find the next OSC start from cursor
                osc_start = in_buf.find(OSC_START, cursor)
                if osc_start == -1:
                    # No OSC in remaining buffer — forward everything
                    forward_chunks.extend(in_buf[cursor:])
                    cursor = len(in_buf)
                    break
                # Forward bytes up to OSC start
                forward_chunks.extend(in_buf[cursor:osc_start])
                cursor = osc_start
                # Try to find complete OSC
                osc_span, after = find_complete_osc(in_buf, cursor)
                if osc_span is None:
                    # incomplete; keep these bytes for next iteration
                    break
                osc_bytes = bytes(in_buf[osc_span[0]:osc_span[1]])
                cursor = after

                # Is it a 5522 packet?
                parsed = parse_5522_packet(osc_bytes)
                if parsed is None:
                    # not 5522 — forward unchanged
                    forward_chunks.extend(osc_bytes)
                    continue

                fields, payload = parsed
                state, current_password, current_mime_list, \
                request_deadline, data_buf, data_mime = handle_5522(
                    state, fields, payload, master_fd,
                    current_password, current_mime_list,
                    request_deadline, data_buf, data_mime,
                )

            # Whatever we couldn't process, keep in buffer for next read
            in_buf = bytearray(in_buf[cursor:])

            if forward_chunks:
                try:
                    os.write(master_fd, bytes(forward_chunks))
                except OSError:
                    return


def handle_5522(state, fields, payload, master_fd,
                current_password, current_mime_list,
                request_deadline, data_buf, data_mime):
    status = fields.get(b"status", b"")
    log(f"5522 packet: state={state} status={status!r} fields={fields}")

    # --- IDLE: looking for a paste event ---
    # Ghostty sends status=OK with a `password` field.
    # Kitty sends status=OK without a password (no authentication).
    if state == STATE_IDLE:
        if status == b"OK":
            current_password = fields.get(b"password")   # None for kitty
            current_mime_list = []
            log(f"paste event start; password={'yes' if current_password else 'no (kitty)'}")
            return (STATE_COLLECTING_PASTE, current_password, current_mime_list,
                    0, bytearray(), None)
        return (state, current_password, current_mime_list,
                request_deadline, data_buf, data_mime)

    # --- COLLECTING_PASTE: accumulate advertised MIME types ---
    if state == STATE_COLLECTING_PASTE:
        if status == b"DATA" and b"mime" in fields:
            try:
                mime = base64.b64decode(fields[b"mime"]).decode("ascii", "replace")
                current_mime_list.append(mime)
            except Exception as e:
                log("paste mime decode err:", e)
        elif status == b"DONE":
            log(f"paste event complete; mimes={current_mime_list}")
            # Pick the preferred MIME to fetch. Match by base type so that
            # `text/plain;charset=utf-8` matches our `text/plain` entry.
            def base(m):
                return m.split(";", 1)[0].strip().lower()
            advertised_base = {base(m): m for m in current_mime_list}
            chosen = next((advertised_base[b] for b in (base(p) for p in PREFERRED_MIMES)
                           if b in advertised_base), None)
            if not chosen:
                log("no preferred MIME in paste event; synthesizing empty paste")
                synthesize_paste(master_fd, b"")
                return (STATE_IDLE, None, [], 0, bytearray(), None)
            log(f"requesting {chosen} via OSC 5522 type=read")
            send_read_request(chosen, current_password)
            return (STATE_AWAITING_DATA, current_password, current_mime_list,
                    time.monotonic() + DATA_RESPONSE_TIMEOUT, bytearray(), chosen)
        return (state, current_password, current_mime_list,
                request_deadline, data_buf, data_mime)

    # --- AWAITING_DATA: collect data response ---
    if state == STATE_AWAITING_DATA:
        if status == b"OK":
            # start of data response — ignore
            return (state, current_password, current_mime_list,
                    request_deadline, data_buf, data_mime)
        if status == b"DATA" and payload:
            data_buf.extend(payload)
            return (state, current_password, current_mime_list,
                    request_deadline, data_buf, data_mime)
        if status == b"DONE":
            try:
                raw = base64.b64decode(bytes(data_buf))
            except Exception as e:
                log("data b64 decode err:", e)
                raw = b""
            log(f"data response complete: {len(raw)} bytes for {data_mime}")
            # Stash in cache for the xclip shim to find
            try:
                cache_write({data_mime: raw})
            except Exception as e:
                log("cache_write err:", e)
            # Text: insert directly via bracketed paste. Image: push to the
            # Mac pasteboard (darwin) and/or rely on the xclip cache (Linux),
            # then Ctrl+V the focused pane so claude's paste flow fires.
            if data_mime.startswith("text/"):
                synthesize_paste(master_fd, raw)
            else:
                if sys.platform == "darwin":
                    load_into_macos_clipboard(raw, data_mime)
                log("synthesizing Ctrl+V into multiplexer")
                try:
                    os.write(master_fd, b"\x16")
                except OSError:
                    pass
            return (STATE_IDLE, None, [], 0, bytearray(), None)
        if status in (b"EPERM", b"ENOSYS", b"EBUSY", b"EIO", b"EINVAL"):
            log(f"data response error: {status!r}")
            synthesize_paste(master_fd, b"")
            return (STATE_IDLE, None, [], 0, bytearray(), None)

    return (state, current_password, current_mime_list,
            request_deadline, data_buf, data_mime)


def send_read_request(mime, password_b64):
    """Send OSC 5522 read up to ghostty. Ghostty needs password; kitty doesn't."""
    mime_b64 = base64.b64encode(mime.encode()).decode("ascii")
    if password_b64:
        seq = (b"\x1b]5522;type=read:mime=" + mime_b64.encode()
               + b":password=" + password_b64 + b"\x1b\\")
    else:
        seq = (b"\x1b]5522;type=read;" + mime_b64.encode() + b"\x1b\\")
    try:
        os.write(1, seq)
    except OSError:
        pass


def synthesize_paste(master_fd, body):
    """Send a bracketed paste sequence down to tmux (-> focused pane)."""
    seq = b"\x1b[200~" + body + b"\x1b[201~"
    try:
        os.write(master_fd, seq)
    except OSError:
        pass


# ---- tty handling boilerplate ----

# Multiplexers we know how to wrap, keyed by name, mapped to the env var each
# sets inside its panes (used to detect "already inside").
MULTIPLEXERS = {
    "tmux": "TMUX",
    "herdr": "HERDR_ENV",
}


def pick_multiplexer():
    """Invoked as `herdr-wrap` (symlink/copy) -> herdr; otherwise tmux."""
    name = os.path.basename(sys.argv[0])
    if name.endswith("-wrap"):
        name = name[:-len("-wrap")]
    return name if name in MULTIPLEXERS else "tmux"


def is_interactive_attach(mux_name, args):
    """herdr: bare `herdr`, `herdr --session <name>` or `herdr session attach`.
    Everything else (subcommands, --version, --remote, which does its own image
    paste) runs unwrapped. tmux: always bridge, as before."""
    if mux_name != "herdr":
        return True
    if not args:
        return True
    if args[0] == "--session" and len(args) == 2:
        return True
    return args[:2] == ["session", "attach"]


def main():
    mux_name = pick_multiplexer()
    mux = shutil.which(mux_name)
    if not mux:
        sys.stderr.write(f"{mux_name}-wrap: cannot find {mux_name} on PATH\n")
        sys.exit(127)
    target = [mux] + sys.argv[1:]
    log(f"{mux_name}: {mux} args={sys.argv[1:]}")

    # Already inside a multiplexer? Bridging from here is pointless (the outer
    # one already ate the 5522 packets) — just exec the multiplexer normally.
    inside = next((env for env in MULTIPLEXERS.values() if os.environ.get(env)), None)
    if inside:
        log(f"already inside a multiplexer (${inside} set); exec'ing {mux_name} directly")
        os.execv(mux, target)

    # Not a 5522-capable terminal? No bridge to run — exec it normally.
    if not is_supported_terminal():
        log(f"not ghostty/kitty; exec'ing {mux_name} directly")
        os.execv(mux, target)

    # Only bridge an interactive attach. Scripted/CLI use (`herdr pane ...`,
    # `herdr api ... | jq`) must not get our pty, raw mode or escape codes, so
    # it's safe to `alias herdr=herdr-wrap`.
    if not (os.isatty(0) and os.isatty(1)) or not is_interactive_attach(mux_name, sys.argv[1:]):
        log(f"not an interactive attach; exec'ing {mux_name} directly")
        os.execv(mux, target)
    log(f"terminal: ghostty={is_ghostty()} kitty={is_kitty()}")

    # Spawn the multiplexer in a pty
    pid, master_fd = pty.fork()
    if pid == 0:
        # child
        try:
            os.execv(mux, target)
        except OSError as e:
            sys.stderr.write(f"{mux_name}-wrap: failed to exec {mux}: {e}\n")
            os._exit(127)

    log(f"forked {mux_name} pid={pid}")

    # Propagate initial window size
    try:
        sz = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(master_fd, termios.TIOCSWINSZ, sz)
    except Exception:
        pass

    def on_winch(_sig, _frame):
        try:
            sz = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master_fd, termios.TIOCSWINSZ, sz)
        except Exception:
            pass
    signal.signal(signal.SIGWINCH, on_winch)

    # Stdin to raw mode so we don't munge what we forward
    old_attrs = None
    try:
        old_attrs = termios.tcgetattr(0)
        tty.setraw(0)
    except (termios.error, OSError):
        pass

    # Tell ghostty we speak 5522 (sent straight up — tmux is below us)
    os.write(1, b"\x1b[?5522h")
    log("sent CSI ? 5522 h")

    try:
        proxy(master_fd)
    finally:
        # Disable mode 5522 so future apps in this terminal aren't surprised,
        # and scrub any mouse-tracking / bracketed-paste modes tmux (mouse on)
        # or a pane app left enabled — otherwise an unexpected exit strands the
        # terminal spewing SGR mouse reports as text.
        try:
            os.write(
                1,
                b"\x1b[?5522l"      # our 5522 paste mode
                b"\x1b[?1000l"      # mouse: normal tracking
                b"\x1b[?1002l"      # mouse: button-event tracking
                b"\x1b[?1003l"      # mouse: any-event tracking
                b"\x1b[?1006l"      # mouse: SGR extended encoding
                b"\x1b[?1015l"      # mouse: urxvt extended encoding
                b"\x1b[?1005l"      # mouse: UTF-8 extended encoding
                b"\x1b[?2004l"      # bracketed paste
                b"\x1b[?25h",       # show cursor
            )
        except OSError:
            pass
        if old_attrs is not None:
            try:
                termios.tcsetattr(0, termios.TCSADRAIN, old_attrs)
            except (termios.error, OSError):
                pass
        try:
            os.close(master_fd)
        except OSError:
            pass

    # reap tmux
    try:
        _, status = os.waitpid(pid, 0)
        if os.WIFEXITED(status):
            sys.exit(os.WEXITSTATUS(status))
        sys.exit(1)
    except ChildProcessError:
        sys.exit(0)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
